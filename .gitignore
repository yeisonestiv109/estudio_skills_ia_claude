# ---------------------------------------------------------------------------
# Entornos virtuales de Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Artefactos de bytecode / cache de Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ---------------------------------------------------------------------------
# Herramientas de test / cobertura / type-checking
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Empaquetado / distribución
# ---------------------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/

# ---------------------------------------------------------------------------
# Secretos y configuración local (NUNCA versionar)
# Excepción: .env.example es la PLANTILLA PÚBLICA (sin secretos reales, solo
# nombres de variable + comentarios) — SÍ debe versionarse para que
# cualquier colaborador sepa qué variables configurar. Bug encontrado en la
# auditoría 22-Jul-2026: el patrón .env.* la ignoraba silenciosamente, así
# que el archivo nunca llegó al repo remoto pese a existir en disco.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
secrets.json
credentials.json

# Datos reales de clientes (CRM/leads/financieros) — nunca versionar PII ni
# credenciales de proyectos Supabase de clientes.
03_Clientes_y_Casos/02_Cliente_ARTF/Tarea_1_Migrar_DB/*.csv
03_Clientes_y_Casos/02_Cliente_ARTF/Tarea_1_Migrar_DB/*.xlsx
03_Clientes_y_Casos/02_Cliente_ARTF/Tarea_1_Migrar_DB/*.xls
03_Clientes_y_Casos/02_Cliente_ARTF/Tarea_1_Migrar_DB/.env

# Transcripciones de reuniones (PII / info de negocio sensible, Segundo
# Cerebro Fase 1, 14-ago-2026) — la carpeta y su README sí se versionan, el
# contenido real no, hasta definir en Fase 2 una política completa de qué se
# puede subir.
01_Gobernanza_EOS/Reuniones_Audios_Negocio/*.md
!01_Gobernanza_EOS/Reuniones_Audios_Negocio/README.md
03_Clientes_y_Casos/02_Cliente_ARTF/Reuniones_Audios/*.md
!03_Clientes_y_Casos/02_Cliente_ARTF/Reuniones_Audios/README.md

# ---------------------------------------------------------------------------
# Artefactos de IDE / sistema operativo
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Graphify — grafo de conocimiento del código (regenerable con `graphify extract`)
# ---------------------------------------------------------------------------
graphify-out/

# ---------------------------------------------------------------------------
# Estado operativo generado en runtime (no es código, no es fuente de verdad
# del repo) — la cola de revisión manual persiste decisiones humanas que
# varían por corrida y por operador local; no debe versionarse ni generar
# conflictos de merge entre corridas de distintas personas. Anclado a la
# raíz del repo (/) para NO afectar el paquete de código homónimo en
# src/adapters/revision_manual/.
# ---------------------------------------------------------------------------
/revision_manual/

# Claude Code local settings (personal, not team-shared)
.claude/settings.local.json
