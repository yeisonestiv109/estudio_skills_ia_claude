# ---------------------------------------------------------------------------
# El Prospector — Variables de Entorno (PLANTILLA PÚBLICA)
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` NUNCA se sube al repositorio (.gitignore lo excluye).
# ---------------------------------------------------------------------------

# Motor 1 y Motor 2 (Capa 2, PropuestaValorAdapter): LLM para análisis de ICP
# y clasificación semántica de competidores/tamaño.
# Obtener en: https://console.groq.com/keys
#
# Rotación de claves (opcional, recomendado para batches grandes): el tier
# gratuito de Groq limita 100k Tokens Por Día POR CLAVE. PropuestaValorAdapter
# hace una llamada LLM por cada empresa candidata ambigua del Negative ICP —
# en un batch de 50 empresas esto agota una sola clave gratuita a mitad de
# camino. Define GROQ_API_KEY_1, GROQ_API_KEY_2, etc. (tantas como cuentas
# gratuitas tengas) para que el adaptador rote automáticamente a la siguiente
# clave disponible cuando la activa reciba un 429 (ver
# src/adapters/llm/groq_key_pool.py). Si NO defines ninguna GROQ_API_KEY_N,
# se usa GROQ_API_KEY como única clave (comportamiento previo, sin rotación).
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Motor 2: Señales de vacantes y stack tecnológico
# Obtener en: https://theirstack.com/settings
THEIRSTACK_API_KEY=

# Motor 2: SecopSocrataAdapter — señales de contratos gubernamentales (SECOP II).
# Opcional: Socrata funciona sin token, pero aplica throttling agresivo a
# tráfico anónimo. Un App Token (gratuito) eleva el límite de tasa.
# IMPORTANTE: usa el token de la sección "Tokens de la aplicación" (lectura),
# NO el de "Claves API" (escritura) — Socrata rechaza el segundo con 403.
# Obtener en: https://www.datos.gov.co (crear cuenta → "Perfil" → "Tokens de aplicación")
SECOP_APP_TOKEN=

# Motor 2: GitHubAdapter — actividad de código público de la organización.
# Opcional: sin token, 60 req/h; con token personal, 5000 req/h.
# Obtener en: https://github.com/settings/tokens (scope: public_repo o ninguno)
GITHUB_TOKEN=

# Motor 3: Enriquecimiento y verificación de correos
# Obtener en: https://app.hunter.io/api_key
HUNTER_API_KEY=

# Motor 3: Descubrimiento de contactos B2B
# Obtener en: https://developer.apollo.io
APOLLO_API_KEY=

# Motor 4: Contexto RAG fresco de internet
# Obtener en: https://app.tavily.com/home
TAVILY_API_KEY=

# Motor 4: Proveedor de envío de correos
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_REMITENTE=
